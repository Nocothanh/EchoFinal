{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "credentialsSource": "local",
        "env": {
          "NODE_ENV": "production"
        }
      },
      "install": "npm install && npx expo install --fix"
    },
    "production": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "credentialsSource": "local",
        "env": {
          "NODE_ENV": "production"
        }
      },
      "install": "npm install && npx expo install --fix"
    }
  },
  "submit": {
    "preview": {},
    "production": {}
  }
}
