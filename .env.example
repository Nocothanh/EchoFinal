# Echo AI - Environment Configuration Example
# Copia questo file a .env e riempilo con le tue credenziali.
# NON committare il file .env al repository!

# === GROQ LLM API ===
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# === ELEVENLABS TTS ===
ELEVENLABS_API_KEY=your_elevenlabs_key_here
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_VOICE_NAME=Bella

# === JARVIS CONFIG ===
JARVIS_USER_NAME=User
JARVIS_TIMEZONE=Europe/Rome
JARVIS_WAKE_WORD=Echo

# === BUILD CONFIG ===
NODE_ENV=production

# === DEBUG ===
DEBUG_MODE=false
