# Echo AI - Environment Configuration Example
# Copia questo file a .env e riempilo con le tue credenziali.
# NON committare il file .env al repository!
#
# NOTA: Ora puoi configurare le API keys direttamente dall'app
#       nella schermata Impostazioni. Questo file è solo un fallback.

# === GROQ LLM API (Gratuito!) ===
# Registrati su: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# === OPENAI API (Opzionale) ===
# Registrati su: https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# === ANTHROPIC API (Opzionale) ===
# Registrati su: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# === ELEVENLABS TTS (Opzionale) ===
# Registrati su: https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_key_here
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_VOICE_NAME=Bella

# === JARVIS CONFIG ===
JARVIS_USER_NAME=User
JARVIS_TIMEZONE=Europe/Rome
JARVIS_WAKE_WORD=Echo

# === BUILD CONFIG ===
NODE_ENV=production

# === DEBUG ===
DEBUG_MODE=false
