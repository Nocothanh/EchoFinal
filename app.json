{
  "expo": {
    "name": "Echo AI",
    "slug": "echoai",
    "owner": "nicothanhbolos-organization",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#8b5cf6"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.echo.ai",
      "buildNumber": "1",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Echo AI uses the microphone for voice input.",
        "NSCameraUsageDescription": "Echo AI uses the camera so Echo can see photos you share.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./adaptive-icon.png",
        "backgroundColor": "#8b5cf6"
      },
      "package": "com.echo.ai",
      "versionCode": 1,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "echo.ai"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./favicon.png",
      "name": "Echo AI",
      "shortName": "Echo AI",
      "description": "Echo AI - Personalità Autentica",
      "themeColor": "#8b5cf6",
      "backgroundColor": "#8b5cf6"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#8b5cf6",
          "image": "./splash.png",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Echo usa il microfono per ascoltare la tua voce.",
          "speechRecognitionPermission": "Echo usa il riconoscimento vocale per trascrivere i tuoi comandi."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9f679501-ec5e-4553-9007-93d417af540c"
      }
    }
  }
}
